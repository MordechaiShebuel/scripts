FROM docker.io/voidlinux/voidlinux:latest

# Prefer the official main repo
RUN mkdir -p /etc/xbps.d && \
    printf '%s\n' \
      'repository=https://repo-default.voidlinux.org/current' \
      > /etc/xbps.d/00-repository-main.conf

# Keep XBPS itself current
RUN xbps-install -Suy xbps && \
    xbps-install -Syu

# Build toolchain + kernel deps + tools needed by xbps-src / repo management
RUN xbps-install -y \
    base-devel \
    git \
    curl \
    wget \
    rsync \
    xz \
    lz4 \
    zstd \
    bc \
    kmod \
    elfutils-devel \
    flex \
    bison \
    openssl-devel \
    pahole \
    python3 \
    patch \
    cpio \
    bash \
    dracut \
    grub \
    xtools

# Non-root builder user
RUN useradd -m -s /bin/bash -u 1000 builder   # match a typical host UID
WORKDIR /home/builder

# Scripts and optional default config
COPY repo_builder.sh /home/builder/
# Optional Server
COPY serve_repo.sh   /home/builder/
RUN chmod +x /home/builder/*.sh

# Optional: pre-seed a kernel .config if you always use the same one
# COPY .config /home/builder/config

USER builder
ENV HOME=/home/builder
