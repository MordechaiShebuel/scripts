{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "type": "kitty-direct",
        "source": "/home/mshalom/.config/fastfetch/images/void.png",
        "width": 30,
        "height": 15,
        "padding": {
            "right": 3
        }
    },

    "display": {
        "separator": "  ",
        "key": {
            "width": 14
        }
    },

    "modules": [
        {
            "type": "title",
            "format": "{user-name}@{host-name}"
        },
        "separator",
        {
            "type": "os",
            "format": "{pretty-name}"
        },
        "kernel",
        "uptime",
        "packages",
        "shell",
        "display",
        "de",
        "wm",
        "terminal",
        "cpu",
        "gpu",
        "memory",
        "disk",
        "colors"
    ]
}
